# Aucun script d'installation des dépendances n'est exécuté (menace M06) ; versions exactes, verrou obligatoire.
ignore-scripts=true
save-exact=true
engine-strict=true
audit=true
fund=false
# Une version publiée depuis moins de 7 jours n'est jamais résolue (paquet piégé souvent retiré dans ce délai ; npm 11.10 ou plus).
min-release-age=7
