# Aucun script d'installation des dépendances n'est exécuté (menace M06) ; versions exactes, verrou obligatoire.
ignore-scripts=true
save-exact=true
engine-strict=true
audit=true
fund=false
# Une version publiée depuis moins de 7 jours n'est jamais résolue (paquet piégé souvent retiré dans ce délai ; npm 11.10 ou plus).
# Ignoré par npm 10 : la règle est vérifiée en CI sur le fichier de verrouillage (scripts/ci/lockfile-age.mjs).
# Pour mettre à jour les dépendances, utiliser npx npm@11.21.2 install (ou une version 11.10 ou plus).
min-release-age=7
